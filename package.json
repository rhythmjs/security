{
  "name": "@rhythmjs/security",
  "version": "0.0.9",
  "description": "Security middleware (CORS, CSRF protection, secure headers, rate limiting) for Rhythm routers and handlers.",
  "keywords": [
    "cors",
    "csrf",
    "helmet",
    "middleware",
    "rate-limit",
    "rhythm",
    "secure-headers",
    "security"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/security.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./authentication": {
      "types": "./dist/authentication/authentication.d.ts",
      "default": "./dist/authentication/authentication.js"
    },
    "./authorization": {
      "types": "./dist/authorization/authorization.d.ts",
      "default": "./dist/authorization/authorization.js"
    },
    "./cors": {
      "types": "./dist/cors/cors.d.ts",
      "default": "./dist/cors/cors.js"
    },
    "./csrf": {
      "types": "./dist/csrf/csrf.d.ts",
      "default": "./dist/csrf/csrf.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/rate-limit.d.ts",
      "default": "./dist/rate-limit/rate-limit.js"
    },
    "./secure-headers": {
      "types": "./dist/secure-headers/secure-headers.d.ts",
      "default": "./dist/secure-headers/secure-headers.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/authentication/authentication.ts src/authorization/authorization.ts src/cors/cors.ts src/csrf/csrf.ts src/rate-limit/rate-limit.ts src/secure-headers/secure-headers.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src",
    "fmt": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.6.3",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": ">=0.0.18",
    "@rhythmjs/router": ">=0.0.18"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
